{
  "name": "git-graph-yzc",
  "displayName": "Git Graph YZC",
  "description": "A Git history viewer for Cursor with bulk branch selection and remembered repository filters",
  "version": "0.1.3",
  "publisher": "sytuacmdyh",
  "repository": {
    "type": "git",
    "url": "https://github.com/sytuacmdyh/git-graph-plus"
  },
  "homepage": "https://github.com/sytuacmdyh/git-graph-plus#readme",
  "bugs": { "url": "https://github.com/sytuacmdyh/git-graph-plus/issues" },
  "license": "Apache-2.0",
  "icon": "resources/icon-marketplace.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization"
  ],
  "keywords": [
    "git",
    "graph",
    "branch",
    "commit",
    "history",
    "visualization",
    "merge",
    "rebase",
    "stash",
    "gui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "l10n": "./l10n",
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gitGraphYzc.showFileHistory",
        "title": "%command.showFileHistory%",
        "icon": "$(history)"
      },
      {
        "command": "gitGraphYzc.open",
        "title": "%command.open%",
        "icon": "$(git-merge)"
      },
      {
        "command": "gitGraphYzc.refresh",
        "title": "%command.refresh%",
        "icon": "$(refresh)"
      },
      {
        "command": "gitGraphYzc.fetch",
        "title": "%command.fetch%",
        "icon": "$(cloud-download)"
      },
      {
        "command": "gitGraphYzc.pull",
        "title": "%command.pull%",
        "icon": "$(arrow-down)"
      },
      {
        "command": "gitGraphYzc.push",
        "title": "%command.push%",
        "icon": "$(arrow-up)"
      },
      {
        "command": "gitGraphYzc.publishBranch",
        "title": "%command.publishBranch%",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "gitGraphYzc.checkoutBranch",
        "title": "Checkout Branch",
        "icon": "$(arrow-right)"
      },
      {
        "command": "gitGraphYzc.createBranch",
        "title": "%command.createBranch%",
        "icon": "$(add)"
      },
      {
        "command": "gitGraphYzc.stashSave",
        "title": "%command.stashSave%",
        "icon": "$(archive)"
      },
      {
        "command": "gitGraphYzc.createTag",
        "title": "%command.createTag%",
        "icon": "$(tag)"
      },
      {
        "command": "gitGraphYzc.pushTag",
        "title": "%command.pushTag%",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "gitGraphYzc.pushAllTags",
        "title": "%command.pushAllTags%",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "gitGraphYzc.deleteRemoteTag",
        "title": "%command.deleteRemoteTag%",
        "icon": "$(trash)"
      },
      {
        "command": "gitGraphYzc.deleteBranch",
        "title": "%command.deleteBranch%",
        "icon": "$(trash)"
      },
      {
        "command": "gitGraphYzc.renameBranch",
        "title": "%command.renameBranch%",
        "icon": "$(edit)"
      },
      {
        "command": "gitGraphYzc.deleteTag",
        "title": "%command.deleteTag%",
        "icon": "$(trash)"
      },
      {
        "command": "gitGraphYzc.mergeBranch",
        "title": "%command.mergeBranch%",
        "icon": "$(git-merge)"
      },
      {
        "command": "gitGraphYzc.showRemoteBranchMenu",
        "title": "%command.checkoutRemoteBranch%",
        "icon": "$(git-branch)"
      },
      {
        "command": "gitGraphYzc.checkoutRemoteBranch",
        "title": "Checkout Remote Branch",
        "icon": "$(arrow-right)"
      },
      {
        "command": "gitGraphYzc.deleteRemoteBranch",
        "title": "Delete Remote Branch",
        "icon": "$(trash)"
      },
      {
        "command": "gitGraphYzc.stashApply",
        "title": "%command.stashApply%",
        "icon": "$(check)"
      },
      {
        "command": "gitGraphYzc.stashPop",
        "title": "%command.stashPop%",
        "icon": "$(check-all)"
      },
      {
        "command": "gitGraphYzc.stashDrop",
        "title": "%command.stashDrop%",
        "icon": "$(trash)"
      },
      {
        "command": "gitGraphYzc.openWorktree",
        "title": "%command.openWorktree%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "gitGraphYzc.openWorktreeInFileExplorer",
        "title": "%command.openWorktreeInFileExplorer%",
        "icon": "$(folder-opened)"
      },
      {
        "command": "gitGraphYzc.removeWorktree",
        "title": "%command.removeWorktree%",
        "icon": "$(trash)"
      },
      {
        "command": "gitGraphYzc.addWorktree",
        "title": "%command.addWorktree%",
        "icon": "$(add)"
      },
      {
        "command": "gitGraphYzc.pruneWorktrees",
        "title": "%command.pruneWorktrees%",
        "icon": "$(clear-all)"
      }
    ],
    "views": {
      "scm": [
        {
          "id": "gitGraphYzc.branches",
          "name": "Branches",
          "icon": "$(git-branch)",
          "visibility": "visible"
        },
        {
          "id": "gitGraphYzc.remotes",
          "name": "Remotes",
          "icon": "$(cloud)"
        },
        {
          "id": "gitGraphYzc.tags",
          "name": "Tags",
          "icon": "$(tag)"
        },
        {
          "id": "gitGraphYzc.stashes",
          "name": "Stashes",
          "icon": "$(archive)"
        },
        {
          "id": "gitGraphYzc.worktrees",
          "name": "Worktrees",
          "icon": "$(worktree)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "gitGraphYzc.branches",
        "contents": "No git repository found.\n[Open Folder](command:vscode.openFolder)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "gitGraphYzc.showFileHistory",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "navigation@20"
        }
      ],
      "editor/title": [
        {
          "command": "gitGraphYzc.open",
          "group": "navigation"
        }
      ],
      "scm/title": [
        {
          "command": "gitGraphYzc.open",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ],
      "view/title": [
        {
          "command": "gitGraphYzc.open",
          "when": "view =~ /^gitGraphYzc/",
          "group": "navigation@1"
        },
        {
          "command": "gitGraphYzc.refresh",
          "when": "view =~ /^gitGraphYzc/",
          "group": "navigation@2"
        },
        {
          "command": "gitGraphYzc.fetch",
          "when": "view == gitGraphYzc.branches || view == gitGraphYzc.remotes",
          "group": "navigation@3"
        },
        {
          "command": "gitGraphYzc.pull",
          "when": "view == gitGraphYzc.branches",
          "group": "navigation@4"
        },
        {
          "command": "gitGraphYzc.push",
          "when": "view == gitGraphYzc.branches && gitGraphYzc.currentBranchHasUpstream != false",
          "group": "navigation@5"
        },
        {
          "command": "gitGraphYzc.publishBranch",
          "when": "view == gitGraphYzc.branches && gitGraphYzc.currentBranchHasUpstream == false",
          "group": "navigation@5"
        },
        {
          "command": "gitGraphYzc.createBranch",
          "when": "view == gitGraphYzc.branches",
          "group": "navigation@6"
        },
        {
          "command": "gitGraphYzc.createTag",
          "when": "view == gitGraphYzc.tags",
          "group": "navigation@3"
        },
        {
          "command": "gitGraphYzc.pushAllTags",
          "when": "view == gitGraphYzc.tags",
          "group": "navigation@4"
        },
        {
          "command": "gitGraphYzc.stashSave",
          "when": "view == gitGraphYzc.stashes",
          "group": "navigation@3"
        },
        {
          "command": "gitGraphYzc.addWorktree",
          "when": "view == gitGraphYzc.worktrees",
          "group": "navigation@3"
        },
        {
          "command": "gitGraphYzc.pruneWorktrees",
          "when": "view == gitGraphYzc.worktrees",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "gitGraphYzc.checkoutBranch",
          "when": "view == gitGraphYzc.branches && viewItem == branch",
          "group": "1_branch@1"
        },
        {
          "command": "gitGraphYzc.mergeBranch",
          "when": "view == gitGraphYzc.branches && viewItem == branch",
          "group": "1_branch@2"
        },
        {
          "command": "gitGraphYzc.renameBranch",
          "when": "view == gitGraphYzc.branches && viewItem == branch",
          "group": "1_branch@3"
        },
        {
          "command": "gitGraphYzc.deleteBranch",
          "when": "view == gitGraphYzc.branches && viewItem == branch",
          "group": "2_danger@1"
        },
        {
          "command": "gitGraphYzc.checkoutRemoteBranch",
          "when": "view == gitGraphYzc.remotes && viewItem == remote-branch",
          "group": "1_branch@1"
        },
        {
          "command": "gitGraphYzc.deleteRemoteBranch",
          "when": "view == gitGraphYzc.remotes && viewItem == remote-branch",
          "group": "2_danger@1"
        },
        {
          "command": "gitGraphYzc.checkoutBranch",
          "when": "view == gitGraphYzc.tags && viewItem == tag",
          "group": "0_checkout@1"
        },
        {
          "command": "gitGraphYzc.pushTag",
          "when": "view == gitGraphYzc.tags && viewItem == tag",
          "group": "1_push@1"
        },
        {
          "command": "gitGraphYzc.deleteRemoteTag",
          "when": "view == gitGraphYzc.tags && viewItem == tag",
          "group": "2_danger@1"
        },
        {
          "command": "gitGraphYzc.deleteTag",
          "when": "view == gitGraphYzc.tags && viewItem == tag",
          "group": "2_danger@2"
        },
        {
          "command": "gitGraphYzc.stashApply",
          "when": "view == gitGraphYzc.stashes && viewItem == stash",
          "group": "1_stash@1"
        },
        {
          "command": "gitGraphYzc.stashPop",
          "when": "view == gitGraphYzc.stashes && viewItem == stash",
          "group": "1_stash@2"
        },
        {
          "command": "gitGraphYzc.stashDrop",
          "when": "view == gitGraphYzc.stashes && viewItem == stash",
          "group": "2_danger@1"
        },
        {
          "command": "gitGraphYzc.openWorktree",
          "when": "view == gitGraphYzc.worktrees && (viewItem == worktree || viewItem == worktree-main)",
          "group": "1_worktree@1"
        },
        {
          "command": "gitGraphYzc.openWorktreeInFileExplorer",
          "when": "view == gitGraphYzc.worktrees && (viewItem == worktree || viewItem == worktree-main)",
          "group": "1_worktree@2"
        },
        {
          "command": "gitGraphYzc.removeWorktree",
          "when": "view == gitGraphYzc.worktrees && viewItem == worktree",
          "group": "2_danger@1"
        }
      ]
    },
    "configuration": {
      "title": "Git Graph YZC",
      "properties": {
        "gitGraphYzc.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Automatically refresh when repository changes are detected"
        },
        "gitGraphYzc.locale": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "ko",
            "zh-cn"
          ],
          "default": "auto",
          "description": "UI language (auto = follow VS Code language setting)"
        },
        "gitGraphYzc.timeout": {
          "type": "integer",
          "default": 60,
          "minimum": 1,
          "markdownDescription": "Maximum time (in seconds) to wait for a Git command before it is aborted. Increase this if the graph times out while loading in a very large repository."
        },
        "gitGraphYzc.initialCommitCount": {
          "type": "integer",
          "default": 200,
          "minimum": 1,
          "markdownDescription": "Number of commits loaded when the graph first renders (and on refresh). Lower this to speed up loading in very large repositories; raise it to see more history without clicking **Load more**."
        },
        "gitGraphYzc.loadMoreCommitCount": {
          "type": "integer",
          "default": 50,
          "minimum": 1,
          "markdownDescription": "Number of additional commits fetched each time the **Load more commits** button is clicked."
        },
        "gitGraphYzc.interactiveRebase.mode": {
          "type": "string",
          "enum": ["ui", "classic"],
          "enumDescriptions": [
            "Open the built-in graphical interactive-rebase editor",
            "Run git rebase -i in the integrated terminal using your configured Git editor"
          ],
          "default": "ui",
          "markdownDescription": "How **Interactive Rebase** opens: the built-in GUI editor (`ui`), or the classic `git rebase -i` flow in the integrated terminal (`classic`), which uses your configured Git editor (e.g. vim, nano, `code --wait`)."
        },
        "gitGraphYzc.graphSortOrder": {
          "type": "string",
          "enum": [
            "author-date",
            "date",
            "topological"
          ],
          "enumDescriptions": [
            "Sort commits by author date (--author-date-order)",
            "Sort commits by committer date (--date-order)",
            "Sort commits by topology, parents after children (--topo-order)"
          ],
          "default": "topological",
          "description": "Commit sort order in the graph"
        },
        "gitGraphYzc.showSignatureStatus": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show a GPG/SSH signature status icon next to each commit in the graph. ⚠️ This verifies the signature of every commit in the log, which can slow down loading on very large repositories — turn it off if you notice slow graph loading. The Commit Details panel always shows signature status on demand regardless of this setting."
        },
        "gitGraphYzc.branchBadgeBarThickness": {
          "type": "string",
          "enum": [
            "thin",
            "medium",
            "thick"
          ],
          "enumDescriptions": [
            "Thin colored bar (4px)",
            "Medium colored bar (6px)",
            "Thick colored bar (8px) — easier to tell branches apart, helpful for color vision deficiency"
          ],
          "default": "thin",
          "description": "Thickness of the colored accent bar on the left of branch badges in the graph"
        },
        "gitGraphYzc.branchColors": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "properties": {
              "pattern": {
                "type": "string",
                "description": "Regular expression matched against the branch name (without remote prefix), e.g. ^main$ or .+/hotfix/.+"
              },
              "color": {
                "type": "string",
                "description": "Hex color, e.g. #00FF00 or #0f0"
              }
            },
            "required": ["pattern", "color"]
          },
          "markdownDescription": "Assign fixed colors to branches by name pattern in the graph. Each rule is `{ \"pattern\": <regex>, \"color\": <hex> }`; the first matching rule wins. Branches matching no rule keep an automatic color. Patterns are regular expressions and match anywhere in the name unless anchored (use `^main$` for an exact match)."
        },
        "gitGraphYzc.graphColors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "#63b0f4",
            "#73d13d",
            "#ff7a45",
            "#b37feb",
            "#f759ab",
            "#36cfc9",
            "#ffc53d",
            "#ff4d4f",
            "#597ef7",
            "#9254de",
            "#43e8d8",
            "#faad14"
          ],
          "markdownDescription": "Color palette auto-assigned to graph rails. Each entry is a hex color (`#rgb` or `#rrggbb`). When there are more branches than colors, the palette cycles. Invalid entries are ignored; an empty list falls back to the built-in palette. `branchColors` pattern rules, when present, take precedence over this palette."
        },
        "gitGraphYzc.commitMessageLinks": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "properties": {
              "pattern": {
                "type": "string",
                "description": "Regular expression matched against the commit message, e.g. ([A-Z]+-\\d+). Capture groups are referenced in the URL as $1, $2, ..."
              },
              "url": {
                "type": "string",
                "description": "URL template. $1, $2, ... are replaced by the corresponding capture groups, e.g. https://my.tracker/browse/$1"
              }
            },
            "required": ["pattern", "url"]
          },
          "markdownDescription": "Turn matching text in commit messages into clickable links (Graph, Commit Details, and Reflog). Each rule is `{ \"pattern\": <regex>, \"url\": <template> }`; `$1`, `$2`, … in the template are replaced by the pattern's capture groups. Rules are applied in order, before built-in auto-detection. Only `http`/`https` URLs are opened. Tip: put rules in workspace settings (`.vscode/settings.json`) for per-repository trackers."
        },
        "gitGraphYzc.autoDetectRepoLinks": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Automatically link references based on the `origin` remote. `!123` (GitLab merge requests) is linked for **any** host, including self-hosted GitLab. `#123` (issues) is linked for **github.com** and **gitlab.com** only — on a self-hosted host the issue path can't be determined, so add a `gitGraphYzc.commitMessageLinks` rule for those."
        },
        "gitGraphYzc.defaults.push.force": { "type": "string", "enum": ["none", "with-lease", "force"], "default": "none", "markdownDescription": "⚠️ `with-lease`/`force` pre-checks a force push, which can overwrite remote history." },
        "gitGraphYzc.defaults.push.setUpstream": { "type": "boolean", "default": true, "markdownDescription": "Set the upstream tracking reference with `-u` when pushing." },
        "gitGraphYzc.defaults.push.allTags": { "type": "boolean", "default": false, "markdownDescription": "Also push all tags (`--tags`)." },
        "gitGraphYzc.defaults.pull.rebase": { "type": "boolean", "default": true, "markdownDescription": "Rebase local commits onto the fetched changes instead of merging." },
        "gitGraphYzc.defaults.pull.stash": { "type": "boolean", "default": false, "markdownDescription": "Stash local changes before pulling, then reapply them afterward." },
        "gitGraphYzc.defaults.fetch.allRemotes": { "type": "boolean", "default": false, "markdownDescription": "Fetch from all remotes instead of a single one." },
        "gitGraphYzc.defaults.merge.mode": { "type": "string", "enum": ["default", "no-ff", "squash"], "default": "default", "markdownDescription": "Merge strategy: `default` (fast-forward when possible), `no-ff` (always create a merge commit), or `squash`." },
        "gitGraphYzc.defaults.merge.pushAfter": { "type": "boolean", "default": false, "markdownDescription": "Push the current branch after a successful merge." },
        "gitGraphYzc.defaults.merge.deleteSource": { "type": "boolean", "default": false, "markdownDescription": "⚠️ Pre-checks deleting the merged source branch." },
        "gitGraphYzc.defaults.rebase.autostash": { "type": "boolean", "default": false, "markdownDescription": "Stash and reapply local changes around the rebase (`--autostash`)." },
        "gitGraphYzc.defaults.rebase.pushAfter": { "type": "boolean", "default": false, "markdownDescription": "⚠️ Pre-checks a force-with-lease push after rebase." },
        "gitGraphYzc.defaults.amend.keepMessage": { "type": "boolean", "default": true, "markdownDescription": "Keep the existing commit message (`--no-edit`)." },
        "gitGraphYzc.defaults.amend.resetDate": { "type": "boolean", "default": false, "markdownDescription": "Reset the commit date to now." },
        "gitGraphYzc.defaults.amend.resetAuthor": { "type": "boolean", "default": false, "markdownDescription": "Reset the commit author to you (`--reset-author`)." },
        "gitGraphYzc.defaults.amend.only": { "type": "boolean", "default": false, "markdownDescription": "Amend only the message/metadata without folding in staged changes (`--only`)." },
        "gitGraphYzc.defaults.amend.pushAfter": { "type": "boolean", "default": false, "markdownDescription": "⚠️ Pre-checks a force-with-lease push after amend." },
        "gitGraphYzc.defaults.checkout.dirty": { "type": "string", "enum": ["keep", "stash", "discard"], "default": "keep", "markdownDescription": "⚠️ `discard` pre-selects discarding local changes." },
        "gitGraphYzc.defaults.checkoutRemote.dirty": { "type": "string", "enum": ["keep", "stash", "discard"], "default": "keep", "markdownDescription": "⚠️ `discard` pre-selects discarding local changes." },
        "gitGraphYzc.defaults.createBranch.checkout": { "type": "boolean", "default": true, "markdownDescription": "Check out the new branch right after creating it." },
        "gitGraphYzc.defaults.createBranch.publish": { "type": "boolean", "default": false, "markdownDescription": "Publish the new branch to the remote and set its upstream (`-u`)." },
        "gitGraphYzc.defaults.createTag.push": { "type": "boolean", "default": true, "markdownDescription": "Push the tag to the remote after creating it." },
        "gitGraphYzc.defaults.cherryPick.noCommit": { "type": "boolean", "default": false, "markdownDescription": "Apply the changes without committing (`--no-commit`)." },
        "gitGraphYzc.defaults.cherryPick.pushAfter": { "type": "boolean", "default": false, "markdownDescription": "Push the branch after cherry-picking." },
        "gitGraphYzc.defaults.revert.noCommit": { "type": "boolean", "default": false, "markdownDescription": "Apply the revert without committing (`--no-commit`)." },
        "gitGraphYzc.defaults.revert.pushAfter": { "type": "boolean", "default": false, "markdownDescription": "Push the branch after reverting." },
        "gitGraphYzc.defaults.reset.mode": { "type": "string", "enum": ["soft", "mixed", "hard"], "default": "mixed", "markdownDescription": "⚠️ `hard` pre-selects discarding all changes." },
        "gitGraphYzc.defaults.stashSave.includeUntracked": { "type": "boolean", "default": true, "markdownDescription": "Include untracked files in the stash (`--include-untracked`)." },
        "gitGraphYzc.defaults.stashSave.keepIndex": { "type": "boolean", "default": false, "markdownDescription": "Keep staged changes in the index (`--keep-index`)." },
        "gitGraphYzc.defaults.deleteBranch.force": { "type": "boolean", "default": false, "markdownDescription": "⚠️ Pre-checks force-deleting an unmerged branch." },
        "gitGraphYzc.defaults.deleteBranch.deleteRemote": { "type": "boolean", "default": false, "markdownDescription": "⚠️ Pre-checks deleting the branch from the remote." },
        "gitGraphYzc.defaults.deleteTag.deleteRemote": { "type": "boolean", "default": false, "markdownDescription": "⚠️ Pre-checks deleting the tag from the remote." },
        "gitGraphYzc.defaults.removeWorktree.deleteBranch": { "type": "boolean", "default": false, "markdownDescription": "⚠️ Pre-checks deleting the worktree's branch." }
      }
    }
  },
  "scripts": {
    "build:extension": "node esbuild.config.mjs",
    "build:webview": "cd webview-ui && npm run build",
    "build": "npm run build:extension && npm run build:webview",
    "watch:extension": "node esbuild.config.mjs --watch",
    "watch:webview": "cd webview-ui && npm run dev",
    "dev": "concurrently \"npm:watch:*\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "vsce package",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vscode/vsce": "^3.0.0",
    "concurrently": "^9.0.0",
    "esbuild": "^0.25.12",
    "happy-dom": "^20.9.0",
    "svelte": "^5.55.7",
    "typescript": "^5.5.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.45"
  }
}
